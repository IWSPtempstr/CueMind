# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# Covers .env, .env.local, and other environment-specific files
.env
.env.local
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Electron compiled entrypoint
/desktop/electron/dist/

# Server-side chat persistence (SQLite / JSONL)
/.data/

# MCP server (independent package)
/mcp-server/node_modules/
/mcp-server/dist/

# Dataset videos (large media, kept local only)
dataset/*.mp4
