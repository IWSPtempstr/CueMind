{
  "name": "cuemind",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron -r tsx/cjs desktop/electron/main.ts\"",
    "desktop:build": "npm run build && electron-builder --win nsis",
    "helper:build": "dotnet publish native/CueMind.Audio/CueMind.Audio.csproj -c Release -r win-x64 --self-contained false"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "next": "15.5.15",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.15",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
