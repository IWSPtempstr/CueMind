[Unit]
Description=CueMind local llama.cpp inference server (GPU offload)
After=network.target

[Service]
# 沙箱命名空间无 /dev/nvidia*，此服务由 systemd 直接拉起（沙箱外），GPU 可用。
ExecStart=/home/work/llama.cpp/build/bin/llama-server \
  -m /home/work/models/cuemind/Qwen_Qwen3-4B-Instruct-2507-Q4_K_M.gguf \
  --host 127.0.0.1 --port 8082 \
  -c 8192 -ngl 99 -fa on --jinja --reasoning off
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
